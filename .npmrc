# Enforce the Node version pinned by .nvmrc + package.json#engines.
# Without this, npm install/ci treats engines as advisory and silently
# accepts mismatched majors — which previously let host-side `npm install`
# under Node 24 produce native bindings (better-sqlite3) that crashed
# inside the Node-22 VM with NODE_MODULE_VERSION mismatches.
engine-strict=true
