{
  "name": "@roomy-ai/cli",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Host CLI for the Roomy personal AI assistant. `npx @roomy-ai/cli` boots the full stack on http://127.0.0.1:35138/.",
  "type": "module",
  "bin": {
    "roomy": "src/roomy.mjs"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "node -e \"console.log('cli has no ts to typecheck yet')\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@roomy-ai/api": "0.2.1",
    "@roomy-ai/app": "0.2.1",
    "@roomy-ai/db": "0.2.1",
    "@roomy-ai/runtime": "0.2.1",
    "@roomy-ai/scheduler": "0.2.1",
    "@roomy-ai/shared": "0.2.1",
    "@roomy-ai/storage": "0.2.1",
    "tsx": "^4.19.2"
  }
}
