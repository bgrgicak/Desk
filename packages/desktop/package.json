{
  "name": "@roomy-ai/desktop",
  "version": "0.2.0",
  "type": "module",
  "description": "Roomy desktop application (Electron)",
  "author": "Agent Roomy",
  "repository": {
    "type": "git",
    "url": "https://github.com/bgrgicak/Desk.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "stage-server": "node scripts/stage-server.mjs",
    "dev": "npm run build && (unset ELECTRON_RUN_AS_NODE; ./node_modules/.bin/electron .)",
    "dist": "npm run build && npm run stage-server && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/patch-electron-name.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
