[Unit]
Description=VM-local shadow of /desk/node_modules (avoids 9p write churn)
# Without this, host-side npm install churns modules on the 9p mount while
# tsx watch inside the VM is running; tsx reacts to unlinks by restarting
# into a broken state. Binding a VM-local copy over the 9p tree makes the
# running server immune to host-side rewrites.
Before=desk-server.service
DefaultDependencies=no
RequiresMountsFor=/desk /home/desk

[Mount]
What=/home/desk/vm-node_modules
Where=/desk/node_modules
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
