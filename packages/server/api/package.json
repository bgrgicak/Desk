{
  "name": "@agent-desk/api",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@agent-desk/dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "build": "tsc",
    "openapi:dump": "npx tsx src/scripts/dump-openapi.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx --conditions=@agent-desk/dev src/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@agent-desk/db": ">=0.1.0-0",
    "@agent-desk/runtime": ">=0.1.0-0",
    "@agent-desk/scheduler": ">=0.1.0-0",
    "@agent-desk/shared": ">=0.1.0-0",
    "@agent-desk/storage": ">=0.1.0-0",
    "@noble/hashes": "^1.8.0",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0",
    "croner": "^10.0.1",
    "kdbxweb": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
