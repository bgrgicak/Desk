{
  "name": "@roomy-ai/api",
  "version": "0.2.4",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@roomy-ai/dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "openapi:dump": "npx tsx src/scripts/dump-openapi.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx --conditions=@roomy-ai/dev src/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@roomy-ai/db": "0.2.4",
    "@roomy-ai/runtime": "0.2.4",
    "@roomy-ai/scheduler": "0.2.4",
    "@roomy-ai/shared": "0.2.4",
    "@roomy-ai/storage": "0.2.4",
    "@noble/hashes": "^1.8.0",
    "@types/busboy": "^1.5.4",
    "@types/ws": "^8.5.14",
    "busboy": "^1.6.0",
    "croner": "^10.0.1",
    "kdbxweb": "^2.1.1",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.14.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
