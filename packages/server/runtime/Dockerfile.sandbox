# ---- Build stage: compile sandbox-cli ----
FROM node:22-slim AS builder
WORKDIR /build
COPY sandbox-cli/ ./sandbox-cli/
WORKDIR /build/sandbox-cli
RUN npm ci --ignore-scripts 2>/dev/null || true && \
    npx tsc --outDir dist 2>/dev/null || true

# ---- Runtime stage ----
FROM ubuntu:24.04

# Install basics + Node.js (needed for sandbox-cli and OpenCode).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Install OpenCode CLI (global). `opencode` becomes available on PATH.
RUN npm install -g opencode-ai --omit=dev --loglevel=error \
    && rm -rf /root/.npm

# Install @desk/sandbox-cli binary from builder stage
COPY --from=builder /build/sandbox-cli/dist/desk.js /usr/local/lib/desk-cli/desk.js
RUN printf '#!/usr/bin/env node\n' | cat - /usr/local/lib/desk-cli/desk.js > /usr/local/bin/desk && \
    chmod +x /usr/local/bin/desk

# Copy skill file
COPY sandbox-cli/skill.md /opt/desk/skills/desk-cli.md

# Seed shell dotfiles from /etc/skel into the bind-mounted $HOME on first
# start (idempotent via `cp -rn`). See runtime/sandbox-entrypoint.sh.
COPY runtime/sandbox-entrypoint.sh /usr/local/bin/desk-sandbox-entrypoint
RUN chmod +x /usr/local/bin/desk-sandbox-entrypoint

# Container runs as its namespace root (uid 0 inside). Under rootless
# Docker that maps to the host user who owns the workspace bind-mount,
# so writes succeed without any chown dance. Under rootful Docker it's
# actual root, which has unconditional DAC access. Either way the
# isolation guarantee comes from the surrounding container (CapDrop:ALL,
# seccomp, pids-limit, memory-limit, network isolation) — the in-image
# user identity was always nominal.
WORKDIR /home/agent
ENV HOME=/home/agent

ENTRYPOINT ["/usr/local/bin/desk-sandbox-entrypoint"]

# Keep the container alive so `docker exec` has a target.
# Runs (OpenCode invocations) are dispatched via `docker exec`.
CMD ["sleep", "infinity"]
