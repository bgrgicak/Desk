# ---- Build stage: compile sandbox-cli ----
FROM node:22-slim AS builder
WORKDIR /build
COPY sandbox-cli/ ./sandbox-cli/
WORKDIR /build/sandbox-cli
RUN npm ci --ignore-scripts 2>/dev/null || true && \
    npx tsc --outDir dist 2>/dev/null || true

# ---- Runtime stage ----
FROM ubuntu:24.04

# Install basics + Node.js (needed for sandbox-cli and OpenCode).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Install OpenCode CLI (global). `opencode` becomes available on PATH.
RUN npm install -g opencode-ai --omit=dev --loglevel=error \
    && rm -rf /root/.npm

# Install @desk/sandbox-cli binary from builder stage. esbuild's `banner`
# config already prepends `#!/usr/bin/env node`, so we just symlink — adding
# a second shebang here would break the file as a Node entry point.
COPY --from=builder /build/sandbox-cli/dist/desk.js /usr/local/lib/desk-cli/desk.js
RUN ln -s /usr/local/lib/desk-cli/desk.js /usr/local/bin/desk && \
    chmod +x /usr/local/lib/desk-cli/desk.js

# Seed shell dotfiles from /etc/skel into the bind-mounted $HOME on first
# start (idempotent via `cp -rn`). See runtime/sandbox-entrypoint.sh.
COPY runtime/sandbox-entrypoint.sh /usr/local/bin/desk-sandbox-entrypoint
RUN chmod +x /usr/local/bin/desk-sandbox-entrypoint

# Unprivileged in-container user. Its uid must match the host user that
# owns the workspace bind-mount (the VM's `desk` service user): the
# workspace root is mounted as $HOME, so host-written files (agent .md,
# attachments, notes) need to be writable by the in-container agent, and
# in-container writes need to stay readable by the host service.
#
# Running as root here doesn't help — the container's HostConfig sets
# CapDrop:ALL, which drops CAP_DAC_OVERRIDE, so even uid 0 obeys normal
# DAC rules and can't write to a dir owned by a different uid.
ARG AGENT_UID=2000
RUN groupadd --gid "$AGENT_UID" agent \
 && useradd --uid "$AGENT_UID" --gid "$AGENT_UID" --create-home --shell /bin/bash agent
WORKDIR /home/agent
ENV HOME=/home/agent
USER agent

ENTRYPOINT ["/usr/local/bin/desk-sandbox-entrypoint"]

# Keep the container alive so `docker exec` has a target.
# Runs (OpenCode invocations) are dispatched via `docker exec`.
CMD ["sleep", "infinity"]
