# ---- Build stage: compile sandbox-cli ----
FROM node:23-slim AS builder
WORKDIR /build
COPY packages/server/sandbox-cli/ ./sandbox-cli/
WORKDIR /build/sandbox-cli
RUN npm install --ignore-scripts --loglevel=error && \
    npm run build

# ---- Build stage: prepare app scaffold template ----
FROM node:23-slim AS app-template
WORKDIR /opt/desk-template
COPY packages/ui/ ./ui/
RUN cd ui && \
    npm install --ignore-scripts --loglevel=error && \
    npm run build && \
    npm pack --loglevel=error
COPY packages/app-scaffold/ ./app/
RUN cd app && \
    cp package.json package.json.template && \
    node -e "const fs=require('node:fs'); const ui=JSON.parse(fs.readFileSync('../ui/package.json','utf8')); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const tarball=ui.name.replace('@','').replace('/','-')+'-'+ui.version+'.tgz'; pkg.dependencies['@agent-desk/ui']='file:../ui/'+tarball; fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2)+'\n')" && \
    npm install --ignore-scripts --loglevel=error && \
    npm run build && \
    rm -rf dist && \
    mv package.json.template package.json

# ---- Runtime stage ----
FROM node:22-slim

LABEL org.opencontainers.image.title="Desk Sandbox" \
      org.opencontainers.image.description="Container image for Desk agent runs (pi coding agent + sandbox helpers)" \
      org.opencontainers.image.source="https://github.com/bgrgicak/Desk" \
      org.opencontainers.image.licenses="MIT"

# Install basics. Node.js/npm are provided by the base image; installing Ubuntu's
# npm package pulls hundreds of Debian packages and has made CI builds stall.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git imagemagick jq pandoc poppler-utils python3 python3-pip sudo \
    && rm -rf /var/lib/apt/lists/*

# Install pi coding agent (global). `pi` becomes available on PATH.
# Pinned: unpinned `@earendil-works/pi-coding-agent` makes every rebuild
# dependent on whatever release was latest at build time. Bump this
# deliberately after smoke-testing a new release.
RUN npm install -g @earendil-works/pi-coding-agent@0.75.4 --omit=dev --loglevel=error \
    && rm -rf /root/.npm

# Install @agent-desk/sandbox-cli binary from builder stage. esbuild's `banner`
# config already prepends `#!/usr/bin/env node`, so we just symlink — adding
# a second shebang here would break the file as a Node entry point. The bin
# is `desk-agent`: `desk` is reserved for the host CLI (@agent-desk/cli); the
# in-sandbox callback tool is what `desk-agent task schedule` invokes.
COPY --from=builder /build/sandbox-cli/dist/desk.js /usr/local/lib/desk-agent-cli/desk-agent.js
RUN ln -s /usr/local/lib/desk-agent-cli/desk-agent.js /usr/local/bin/desk-agent && \
    chmod +x /usr/local/lib/desk-agent-cli/desk-agent.js

# Bake the app scaffold into the sandbox so `desk-agent app create` can clone it
# without network access during agent runs.
COPY --from=app-template /opt/desk-template/app /opt/desk-template/app

# Seed shell dotfiles from /etc/skel into the bind-mounted $HOME on first
# start (idempotent via `cp -rn`). See runtime/sandbox-entrypoint.sh.
COPY packages/server/runtime/sandbox-entrypoint.sh /usr/local/bin/desk-sandbox-entrypoint
RUN chmod +x /usr/local/bin/desk-sandbox-entrypoint

# Baseline `agent` user. The image ships with this baked at AGENT_UID=2000
# so a `docker run` without a per-run --user has *some* unprivileged user
# to run as — but desk-server always passes `--user` of the host process
# (or 0:0 under rootless docker) so the runtime uid is whoever spawned
# the sandbox. /home/agent is the bind-mount target; the workspace root
# on the host lands there directly, so reads/writes both directions just
# work without any chown dance.
ARG AGENT_UID=2000
RUN groupadd --gid "$AGENT_UID" agent \
 && useradd --uid "$AGENT_UID" --gid "$AGENT_UID" --create-home --shell /bin/bash agent \
 && mkdir -p /etc/sudoers.d \
 && printf 'agent ALL=(ALL) NOPASSWD:ALL\n' >/etc/sudoers.d/agent \
 && chmod 0440 /etc/sudoers.d/agent
WORKDIR /home/agent
ENV HOME=/home/agent
USER agent

ENTRYPOINT ["/usr/local/bin/desk-sandbox-entrypoint"]

# Keep the container alive so `docker exec` has a target.
# Runs (pi invocations) are dispatched via `docker exec` per turn.
CMD ["sleep", "infinity"]
