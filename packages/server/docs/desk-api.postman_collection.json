              "raw": "{\n  \"chatId\": \"{{chatId}}\",\n  \"prompt\": \"Summarise today\",\n  \"mode\": \"recurring\",\n  \"spec\": \"0 9 * * *\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/scheduled-jobs", "host": ["{{baseUrl}}"], "path": ["scheduled-jobs"] }
          }
        },
        {
