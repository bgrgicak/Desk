    {
      "name": "Chats",
      "item": [
        {
          "name": "GET /chats",
          "request": {
            "method": "GET",
            "description": "Lists chats filtered by workspaceId. Omit the param to fall back to the caller's first workspace.",
            "url": {
              "raw": "{{baseUrl}}/chats?workspaceId={{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chats"],
              "query": [
                { "key": "workspaceId", "value": "{{workspaceId}}", "description": "wks_* id of a workspace the caller owns. Omit for the first-workspace default.", "disabled": false }
              ]
            }
          }
        },
        {
          "name": "POST /chats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.id) pm.collectionVariables.set('chatId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\",\n  \"agentId\": \"{{agentId}}\",\n  \"title\": \"My chat\",\n  \"goal\": \"Explore the API\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chats", "host": ["{{baseUrl}}"], "path": ["chats"] }
          }
        },
        {
          "name": "GET /chats/:id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}"]
            }
          }
        },
        {
          "name": "PATCH /chats/:id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed chat\",\n  \"goal\": \"Revised goal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}"]
            }
          }
        },
        {
          "name": "DELETE /chats/:id",
          "request": {
            "method": "DELETE",
            "description": "Soft-deletes a chat: cascades messages, cancels scheduler refs, moves .chats/{chatId}/ + chats/{chatId}/ to ~/Desk/.trash/, and broadcasts chat.deleted over WS.",
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}"]
            }
          }
        },
        {
          "name": "GET /chats/:id/messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/messages?cursor=",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}", "messages"],
              "query": [{ "key": "cursor", "value": "", "description": "Opaque pagination cursor" }]
            }
          }
        },
        {
          "name": "POST /chats/:id/messages",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello agent\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}", "messages"]
            }
          }
        },
        {
          "name": "PATCH /chats/:id/messages/:messageId",
