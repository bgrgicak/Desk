          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/scheduled-jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["scheduled-jobs", "{{jobId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Tools",
      "item": [
        {
          "name": "GET /tools/models",
          "request": {
            "method": "GET",
            "description": "Lists AI models that are ready to use — every entry is a provider opencode has authenticated inside the sandbox via a host-forwarded API key. Server-wide, not agent-scoped. Foundation of host-initiated sandboxed tool calling (ARCHITECTURE.md §7).",
            "url": {
              "raw": "{{baseUrl}}/tools/models?provider=anthropic",
              "host": ["{{baseUrl}}"],
              "path": ["tools", "models"],
              "query": [
                { "key": "provider", "value": "anthropic", "description": "Restrict to a single provider id, e.g. anthropic." }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "GET /search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=hello&scope=all",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "hello" },
                { "key": "scope", "value": "all", "description": "all | artifacts | chats | library" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        {
          "name": "GET /openapi.json",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/openapi.json", "host": ["{{baseUrl}}"], "path": ["openapi.json"] }
          }
        },
        {
          "name": "WS /ws (reference only)",
          "request": {
            "method": "GET",
            "description": "WebSocket upgrade endpoint. Postman can connect via File → New → WebSocket Request with URL ws://localhost:3013/ws?token={{token}}. Not reachable via a regular HTTP send.",
            "url": {
              "raw": "{{baseUrl}}/ws?token={{token}}",
              "host": ["{{baseUrl}}"],
              "path": ["ws"],
              "query": [{ "key": "token", "value": "{{token}}" }]
            }
          }
        }
      ]
    }
  ]
}
