    },
    {
      "name": "Library",
      "item": [
        {
          "name": "GET /library",
          "request": {
            "method": "GET",
            "description": "List library files in the given workspace. Omit workspaceId to fall back to the caller's first workspace. Files live under library/{workspaceId}/… on disk.",
            "url": {
              "raw": "{{baseUrl}}/library?workspaceId={{workspaceId}}&cursor=&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["library"],
              "query": [
                { "key": "workspaceId", "value": "{{workspaceId}}", "description": "wks_* id of a workspace the caller owns. Omit for first-workspace default." },
                { "key": "cursor", "value": "" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "POST /library",
          "request": {
            "method": "POST",
            "description": "Upload a file into the given workspace's library. Lands at library/{workspaceId}/{filename}; auto-suffixes on collision.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/library?workspaceId={{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["library"],
              "query": [
                { "key": "workspaceId", "value": "{{workspaceId}}", "description": "wks_* id of destination workspace. Omit for first-workspace default." }
              ]
            }
          }
        },
        {
          "name": "GET /library/meta",
          "request": {
            "method": "GET",
            "description": "Stat a library file by workspace-relative path inside the given workspace. Returns 404 if the path escapes the workspace subtree.",
            "url": {
              "raw": "{{baseUrl}}/library/meta?path={{libraryPath}}&workspaceId={{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["library", "meta"],
              "query": [
                { "key": "path", "value": "{{libraryPath}}" },
                { "key": "workspaceId", "value": "{{workspaceId}}", "description": "wks_* id. Omit for first-workspace default." }
              ]
            }
          }
        },
        {
          "name": "GET /library/download",
          "request": {
            "method": "GET",
            "description": "Stream a library file's bytes from the given workspace.",
            "url": {
              "raw": "{{baseUrl}}/library/download?path={{libraryPath}}&workspaceId={{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["library", "download"],
              "query": [
                { "key": "path", "value": "{{libraryPath}}" },
                { "key": "workspaceId", "value": "{{workspaceId}}", "description": "wks_* id. Omit for first-workspace default." }
              ]
            }
          }
        },
        {
          "name": "DELETE /library",
          "request": {
            "method": "DELETE",
            "description": "Moves the file at ?path= (inside the given workspace) to ~/Desk/.trash/.",
            "url": {
              "raw": "{{baseUrl}}/library?path={{libraryPath}}&workspaceId={{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["library"],
              "query": [
                { "key": "path", "value": "{{libraryPath}}" },
                { "key": "workspaceId", "value": "{{workspaceId}}", "description": "wks_* id. Omit for first-workspace default." }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Messages (cross-chat)",
      "item": [
        {
          "name": "GET /messages",
          "request": {
            "method": "GET",
            "description": "Read-only cross-chat message list. All filters AND-combined. Ownership enforced by SQL join on chats → workspaces.user_id. Ordered createdAt DESC, id DESC. Use to drive Runs (scheduled=true&state=pending, state=running, etc.) and Today/Inbox (awaitingUser=true) without fan-out.",
            "url": {
              "raw": "{{baseUrl}}/messages?workspaceId={{workspaceId}}&chatId=&state=&scheduled=&awaitingUser=&contentKind=&since=&cursor=&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["messages"],
              "query": [
                { "key": "workspaceId", "value": "{{workspaceId}}", "description": "wks_* id. Omit to span all of the caller's workspaces." },
                { "key": "chatId", "value": "", "description": "chat_* id. Omit to span all chats." },
                { "key": "state", "value": "", "description": "pending|running|succeeded|failed|cancelled. Comma-separated list accepted." },
                { "key": "scheduled", "value": "", "description": "true = only rows with executeAt or cron; false = only unscheduled; omit for both." },
                { "key": "awaitingUser", "value": "", "description": "true = only messages in chats whose awaitingUser flag is set." },
                { "key": "contentKind", "value": "", "description": "text|toolCall|toolResult|artifactRef|events|note|ai_note_request|agent_turn. Comma-separated list accepted." },
                { "key": "since", "value": "", "description": "ISO-8601 timestamp. Returns rows with createdAt > since (reconnect catchup)." },
                { "key": "cursor", "value": "", "description": "Opaque pagination cursor from a previous response's nextCursor." },
                { "key": "limit", "value": "50", "description": "Page size, max 200." }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tools",
      "item": [
        {
          "name": "GET /tools/models",
          "request": {
            "method": "GET",
            "description": "Lists AI models that are ready to use — every entry is a provider opencode has authenticated inside the sandbox via a host-forwarded API key. Server-wide, not agent-scoped. Foundation of host-initiated sandboxed tool calling (ARCHITECTURE.md §7).",
            "url": {
              "raw": "{{baseUrl}}/tools/models?provider=anthropic",
              "host": ["{{baseUrl}}"],
              "path": ["tools", "models"],
              "query": [
                { "key": "provider", "value": "anthropic", "description": "Restrict to a single provider id, e.g. anthropic." }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "GET /search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=hello&scope=all",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "hello" },
                { "key": "scope", "value": "all", "description": "all | artifacts | chats | library" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        {
          "name": "GET /openapi.json",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/openapi.json", "host": ["{{baseUrl}}"], "path": ["openapi.json"] }
          }
        },
        {
          "name": "WS /ws (reference only)",
          "request": {
            "method": "GET",
            "description": "WebSocket upgrade endpoint. Postman can connect via File → New → WebSocket Request with URL ws://localhost:35138/ws?token={{token}}. Not reachable via a regular HTTP send.",
            "url": {
              "raw": "{{baseUrl}}/ws?token={{token}}",
              "host": ["{{baseUrl}}"],
              "path": ["ws"],
              "query": [{ "key": "token", "value": "{{token}}" }]
            }
          }
        }
      ]
    }
  ]
}
