{
  "info": {
    "_postman_id": "e3a0d5b2-2f5a-4a4e-9b57-desk-api-v1",
    "name": "Desk API",
    "description": "HTTP + WS gateway for the Desk personal AI assistant. Covers every route exposed by packages/server/api/src/app.ts. Login response auto-stores {{token}}. Set {{baseUrl}} to the forwarded host port of your Lima VM (default dev instance: http://localhost:3013). WebSocket upgrades live at {{baseUrl}}/ws?token={{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3013", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "username", "value": "desk", "type": "string" },
    { "key": "password", "value": "change-me-before-first-boot", "type": "string" },
    { "key": "workspaceId", "value": "", "type": "string" },
    { "key": "agentId", "value": "", "type": "string" },
    { "key": "chatId", "value": "", "type": "string" },
    { "key": "libraryFileId", "value": "", "type": "string" },
    { "key": "runId", "value": "", "type": "string" },
    { "key": "jobId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  console.log('token stored');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Account (/me)",
      "item": [
        {
          "name": "GET /me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        },
        {
          "name": "PATCH /me",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"desk\",\n  \"email\": \"me@example.com\",\n  \"avatarPath\": \"avatars/me.png\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        },
        {
          "name": "DELETE /me",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        },
        {
          "name": "POST /me/password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"testpass\",\n  \"newPassword\": \"new-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/me/password", "host": ["{{baseUrl}}"], "path": ["me", "password"] }
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "GET /workspaces",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/workspaces", "host": ["{{baseUrl}}"], "path": ["workspaces"] }
          }
        },
        {
          "name": "GET /workspaces/:id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            }
          }
        },
        {
          "name": "PATCH /workspaces/:id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My workspace\",\n  \"description\": \"Updated\",\n  \"icon\": \"📒\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            }
          }
        },
        {
          "name": "DELETE /workspaces/:id",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Agents",
      "item": [
        {
          "name": "GET /agents",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/agents", "host": ["{{baseUrl}}"], "path": ["agents"] }
          }
        },
        {
          "name": "GET /agents/:id",
          "request": {
            "method": "GET",
