          }
        },
        {
          "name": "PATCH /agents/:id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My agent\",\n  \"instructions\": \"Be helpful\",\n  \"model\": \"claude-opus-4-7\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agents/{{agentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["agents", "{{agentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Chats",
      "item": [
        {
          "name": "GET /chats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/chats", "host": ["{{baseUrl}}"], "path": ["chats"] }
          }
        },
        {
          "name": "POST /chats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.id) pm.collectionVariables.set('chatId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\",\n  \"agentId\": \"{{agentId}}\",\n  \"title\": \"My chat\",\n  \"goal\": \"Explore the API\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chats", "host": ["{{baseUrl}}"], "path": ["chats"] }
          }
        },
        {
          "name": "GET /chats/:id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}"]
            }
          }
        },
        {
          "name": "PATCH /chats/:id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed chat\",\n  \"goal\": \"Revised goal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}"]
            }
          }
        },
        {
          "name": "GET /chats/:id/messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/messages?cursor=",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}", "messages"],
              "query": [{ "key": "cursor", "value": "", "description": "Opaque pagination cursor" }]
            }
          }
        },
        {
          "name": "POST /chats/:id/messages",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello agent\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}", "messages"]
            }
          }
        },
        {
          "name": "GET /chats/:id/artifacts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/artifacts",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}", "artifacts"]
            }
          }
        },
        {
          "name": "POST /chats/:id/artifacts",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/artifacts",
              "host": ["{{baseUrl}}"],
              "path": ["chats", "{{chatId}}", "artifacts"]
            }
          }
        }
      ]
    },
    {
      "name": "Library",
      "item": [
        {
          "name": "GET /library",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/library?cursor=&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["library"],
              "query": [
                { "key": "cursor", "value": "" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "POST /library",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.id) pm.collectionVariables.set('libraryFileId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"readme.txt\",\n  \"mime\": \"text/plain\",\n  \"contentBase64\": \"aGVsbG8gbGlicmFyeQ==\"\n}"
            },
